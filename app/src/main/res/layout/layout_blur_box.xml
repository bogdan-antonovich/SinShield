<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sinshield_surface"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <TextView
        android:id="@+id/blocked_reason"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/sinshield_navy"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/blocked_explanation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="@string/unsafe_screen_hidden"
        android:textColor="#BF082D48"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/blocked_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:textColor="@color/sinshield_primary"
        android:textSize="16sp" />

    <Button
        android:id="@+id/dismiss_block"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_overlay_button_primary"
        android:backgroundTint="@null"
        android:enabled="false"
        android:text="@string/dismiss"
        android:textAllCaps="false"
        android:textColor="@color/white" />
</LinearLayout>
