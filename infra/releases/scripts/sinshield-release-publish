#!/usr/bin/env bash
set -euo pipefail

domain="releases.sinshield.app"
document_root="/srv/www/$domain"
auth_file="/etc/nginx/conf.d/sinshield-releases-auth.conf"
nginx_group="www-data"

fail() {
  echo "ERROR: $*" >&2
  exit 1
}

if [ "$(id -u)" -ne 0 ]; then
  fail "This publisher must run as root through sudo."
fi

IFS= read -r access_token || true
if [[ ! "$access_token" =~ ^[A-Za-z0-9_-]{32,128}$ ]]; then
  fail "The access token must contain 32-128 URL-safe characters."
fi

configure_auth() {
  local temporary_auth
  temporary_auth="$(mktemp "${auth_file}.tmp.XXXXXX")"
  trap 'rm -f "$temporary_auth"' RETURN

  {
    printf 'map $http_authorization $sinshield_release_header_auth {\n'
    printf '    default 0;\n'
    printf '    "Bearer %s" 1;\n' "$access_token"
    printf '}\n\n'
    printf 'map $arg_token $sinshield_release_query_auth {\n'
    printf '    default 0;\n'
    printf '    "%s" 1;\n' "$access_token"
    printf '}\n\n'
    printf 'map $cookie_sinshield_release_token $sinshield_release_cookie_auth {\n'
    printf '    default 0;\n'
    printf '    "%s" 1;\n' "$access_token"
    printf '}\n\n'
    printf 'map "$sinshield_release_header_auth:$sinshield_release_query_auth:$sinshield_release_cookie_auth" $sinshield_release_authorized {\n'
    printf '    default 0;\n'
    printf '    ~1 1;\n'
    printf '}\n\n'
    printf 'map $sinshield_release_query_auth $sinshield_release_cookie {\n'
    printf '    default "";\n'
    printf '    1 "sinshield_release_token=$arg_token; Path=/; Max-Age=2592000; Secure; HttpOnly; SameSite=Strict";\n'
    printf '}\n'
  } > "$temporary_auth"

  chown root:root "$temporary_auth"
  chmod 0600 "$temporary_auth"
  mv -f "$temporary_auth" "$auth_file"
  trap - RETURN

  nginx -t
  systemctl reload nginx
}

if [ "${1:-}" = "--configure-token" ]; then
  configure_auth
  exit 0
fi

tag="${1:-}"
if [[ ! "$tag" =~ ^v[0-9]{1,4}\.[0-9]{1,3}\.[0-9]{1,3}$ ]]; then
  fail "Expected a release tag in vMAJOR.MINOR.PATCH format."
fi

deploy_user="${SUDO_USER:-}"
if [ -z "$deploy_user" ] || [ "$deploy_user" = "root" ]; then
  fail "Run this command through sudo from the deployment account."
fi

deploy_home="$(getent passwd "$deploy_user" | cut -d: -f6)"
if [ -z "$deploy_home" ]; then
  fail "Unable to resolve the deployment user's home directory."
fi

staging_dir="$deploy_home/sinshield-releases/incoming/$tag"
target_dir="$document_root/$tag"
temporary_dir="$document_root/.${tag}.tmp.$$"
aab_name="sinshield-$tag.aab"
apk_name="sinshield-$tag.apk"

required_files=(
  "$aab_name"
  "$aab_name.sha256"
  "$apk_name"
  "$apk_name.sha256"
  "release.json"
)

verify_checksum() {
  local release_dir="$1"
  local artifact_name="$2"
  local checksum_file="$release_dir/$artifact_name.sha256"
  local expected_name expected_hash actual_hash extra

  read -r expected_hash expected_name extra < "$checksum_file"
  expected_name="${expected_name#\*}"

  [[ "$expected_hash" =~ ^[a-f0-9]{64}$ ]] || fail "Invalid checksum for $artifact_name."
  [ "$expected_name" = "$artifact_name" ] || fail "Checksum filename mismatch for $artifact_name."
  [ -z "${extra:-}" ] || fail "Unexpected checksum content for $artifact_name."

  actual_hash="$(sha256sum "$release_dir/$artifact_name" | cut -d ' ' -f 1)"
  [ "$actual_hash" = "$expected_hash" ] || fail "Checksum verification failed for $artifact_name."
}

verify_release_directory() {
  local release_dir="$1"
  local description="$2"
  local filename path

  [ -d "$release_dir" ] || fail "$description directory does not exist: $release_dir"

  for filename in "${required_files[@]}"; do
    path="$release_dir/$filename"
    [ -f "$path" ] || fail "$description is missing required file: $filename"
    [ ! -L "$path" ] || fail "$description must not contain symbolic links."
  done

  verify_checksum "$release_dir" "$aab_name"
  verify_checksum "$release_dir" "$apk_name"
  grep -Fq '"tag": "'"$tag"'"' "$release_dir/release.json" \
    || fail "$description metadata does not identify release $tag."
}

verify_release_directory "$staging_dir" "Staged release"

# Validate and reload Nginx before committing a new immutable release. A bad
# authentication configuration must not leave a partially published version.
configure_auth

if [ -e "$target_dir" ]; then
  [ -d "$target_dir" ] || fail "Release target exists and is not a directory."
  verify_release_directory "$target_dir" "Published release"
  echo "Release $tag is already published; retaining its verified immutable artifacts."
else
  trap 'rm -rf "$temporary_dir"' EXIT
  install -d -o root -g "$nginx_group" -m 0750 "$temporary_dir"
  for filename in "${required_files[@]}"; do
    install -o root -g "$nginx_group" -m 0640 "$staging_dir/$filename" "$temporary_dir/$filename"
  done
  mv "$temporary_dir" "$target_dir"
  trap - EXIT
  echo "Published immutable release $tag."
fi

latest_link="$document_root/.latest.tmp.$$"
ln -s "$tag" "$latest_link"
mv -Tf "$latest_link" "$document_root/latest"

latest_json="$document_root/.latest.json.tmp.$$"
install -o root -g "$nginx_group" -m 0640 "$target_dir/release.json" "$latest_json"
mv -f "$latest_json" "$document_root/latest.json"

echo "Release $tag is available through the authenticated endpoint."
